# Hugging Face Spaces - Ignore files not needed for deployment

# Flutter app (frontend goes to separate repo)
frontend/
assets/
macos/
windows/
linux/
android/
ios/
build/
test/

# All image types
*.png
*.jpg
*.jpeg
*.gif
*.ico

# Binary app files
*.app
*.ipa
*.apk
*.dmg

# Model files (download during build via huggingface-cli)
pretrained_models/
*.pth
*.pt
*.bin
*.onnx

# Audio files
tmp_audio/

# IDE and cache
.claude/
.vscode/
.idea/
__pycache__/
*.pyc
*.so

# Environment
.env
.env.local
venv/
env/

# Database
*.db
*.sqlite3

# Logs
*.log